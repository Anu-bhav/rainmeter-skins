# ---- Local secrets (never commit) ----
# Weather API keys and any other machine-specific credentials.
*/@Resources/Secrets.inc

# ---- Local dev scratch (not part of the skins) ----
_Dev/

# ---- Rainmeter runtime junk ----
# Generated by Rainmeter at runtime, not part of the skins.
*.log
*.bak
*.tmp
*.ini.bak
Rainmeter.ini
Rainmeter.data
Rainmeter.stats
Layouts/
Settings.ini

# ---- Plugin binaries we build locally (rebuilt from _Source) ----
# The plugin DLL lives in %APPDATA%\Rainmeter\Plugins, not in the repo.
*.dll
*.exe
*.pdb

# ---- Build output ----
bin/
obj/
.vs/
*.user
*.suo

# ---- OS ----
Thumbs.db
desktop.ini
.DS_Store