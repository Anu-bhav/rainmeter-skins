#include <winver.h>

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Nocturne"
            VALUE "FileDescription",  "NocturneCpuTemp - CPU temperature for Rainmeter"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "NocturneCpuTemp"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Anu-Bhav"
            VALUE "OriginalFilename", "NocturneCpuTemp.dll"
            VALUE "ProductName",      "NocturneCpuTemp"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "Comments",         "Intel CPU temperature via PawnIO + IntelMSR (MSR 0x19C). Requires PawnIO and elevation. https://github.com/Anu-bhav/rainmeter-skins"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END