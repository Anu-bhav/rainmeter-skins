; ---------------------------------------------------------------------------
; Local secrets for Simplic. This file is NOT committed to git.
;
; If you clone this repo fresh, copy Secrets.example.inc to Secrets.inc and
; fill in your own values. Rainmeter will use an empty string if the file is
; missing, which simply makes the weather skin show no data.
; ---------------------------------------------------------------------------

; weather.com API key used by Simplic\Weather\Weather.ini
WeatherAPIKey=YOUR_KEY_HERE